{
  "name": "@localzet/ui-kit-3",
  "version": "0.1.0",
  "description": "Zorin UI 3 component kit",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/localzet/ui-kit-3.git"
  },
  "bugs": {
    "url": "https://github.com/localzet/ui-kit-3/issues"
  },
  "homepage": "https://github.com/localzet/ui-kit-3#readme",
  "main": "./dist/zorin-ui-3.umd.js",
  "module": "./dist/zorin-ui-3.mjs",
  "exports": {
    ".": {
      "import": "./dist/zorin-ui-3.mjs",
      "require": "./dist/zorin-ui-3.umd.js"
    },
    "./style.css": "./dist/style.css",
    "./tailwind": "./tailwind.preset.cjs"
  },
  "files": [
    "dist",
    "tailwind.preset.cjs",
    "README.md"
  ],
  "scripts": {
    "build": "npm run build:lib && npm run build:demo",
    "build:lib": "vite build --config vite.config.mjs",
    "build:demo": "vite build --config vite.demo.config.mjs",
    "dev": "vite --config vite.demo.config.mjs --host 127.0.0.1",
    "dev:lib": "vite --config vite.config.mjs --host 127.0.0.1",
    "preview": "vite preview --config vite.demo.config.mjs --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit --skipLibCheck"
  },
  "peerDependencies": {
    "vue": "^2.7.0"
  },
  "peerDependenciesMeta": {
    "axios": {
      "optional": true
    },
    "datatransfer-files-promise": {
      "optional": true
    },
    "lodash": {
      "optional": true
    },
    "pdfvuer": {
      "optional": true
    },
    "twemoji": {
      "optional": true
    },
    "v-click-outside": {
      "optional": true
    },
    "vee-validate": {
      "optional": true
    },
    "vue-feather-icons": {
      "optional": true
    },
    "vue-i18n": {
      "optional": true
    },
    "vue-router": {
      "optional": true
    },
    "vuex": {
      "optional": true
    }
  },
  "dependencies": {
    "axios": "^0.21.4",
    "datatransfer-files-promise": "^1.3.1",
    "lodash": "^4.17.21",
    "pdfvuer": "^1.9.2",
    "tailwind-scrollbar-hide": "^1.1.7",
    "twemoji": "^13.1.1",
    "v-click-outside": "^3.2.0",
    "vee-validate": "^3.4.14",
    "vue-feather-icons": "^5.1.0",
    "vue-i18n": "^8.27.2",
    "vue-router": "^3.5.4",
    "vuex": "^3.6.2"
  },
  "devDependencies": {
    "@vitejs/plugin-vue2": "^2.3.1",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "sass": "^1.89.1",
    "tailwindcss": "^3.4.17",
    "tailwindcss-debug-screens": "^2.2.1",
    "vite": "^6.4.3",
    "vue": "^2.7.16",
    "vue-template-compiler": "^2.7.16",
    "vue-tsc": "^1.8.27"
  }
}
